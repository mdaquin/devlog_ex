# Copier ce fichier en `.env.local` pour activer l'API réelle.

# Mode « factice » (par défaut) ou « reel ».
VITE_API_MODE=reel

# URL utilisée par le navigateur.
# - `/api` (défaut) : passe par le proxy Vite, qui relaie vers l'API.
# - une URL absolue : appelle directement l'API (CORS nécessaire).
# VITE_API_BASE_URL=/api

# Cible et préfixe du proxy Vite (utilisés quand VITE_API_BASE_URL=/api).
# VITE_API_PROXY_TARGET=https://mathieu.com
# VITE_API_PROXY_PREFIX=/ecureuil/api/1.0
